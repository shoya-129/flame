{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flame",
  "scopeName": "source.flame",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.flame",
          "match": "//.*$"
        },
        {
          "name": "comment.block.flame",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.flame",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.decorator.flame"
            },
            "2": {
              "name": "entity.name.function.decorator.flame"
            }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "begin": "\\b(import)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.flame"
            }
          },
          "end": "$|;",
          "patterns": [
            {
              "name": "keyword.control.flame",
              "match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "variable.other.flame",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.flame",
              "match": "\\."
            }
          ]
        },
        {
          "begin": "(@)(plugin)\\b",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.decorator.flame"
            },
            "2": {
              "name": "keyword.control.flame"
            }
          },
          "end": "$|;",
          "patterns": [
            {
              "name": "keyword.control.flame",
              "match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "variable.other.flame",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "string.quoted.double.flame",
              "begin": "\"",
              "end": "\""
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flame",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|defer|return|yield|await|async|thread)\\b"
        },
        {
          "name": "keyword.declaration.flame",
          "match": "\\b(let|const|var|fn|struct|enum|trait|impl|export|import|mut|as|type|where)\\b"
        },
        {
          "name": "variable.language.flame",
          "match": "\\b(self|Self)\\b"
        },
        {
          "name": "constant.language.flame",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.flame",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.flame",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flame",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.flame",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.flame"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.flame"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.flame",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flame",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.flame",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.flame",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.flame",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.flame",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.flame",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.flame",
          "match": "\\b0b[01]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.flame",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.macro.flame",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "variable.other.flame",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}

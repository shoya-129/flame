{
  "name": "flame-vscode",
  "displayName": "Flame Language Support",
  "description": "Rich IDE syntax highlighting and configuration for the Flame programming language.",
  "version": "0.1.0",
  "icon": "flame.png",
  "publisher": "flame-lang",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:flame",
    "onLanguage:flame-wn",
    "onLanguage:flame-config"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flame",
        "aliases": [
          "Flame",
          "flame"
        ],
        "extensions": [
          ".fm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/flame.svg",
          "dark": "./icons/flame.svg"
        }
      },
      {
        "id": "flame-wn",
        "extensions": [
          ".fmi"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "flame-config",
        "extensions": [
          ".fmi"
        ],
        "icon": {
          "light": "./icons/config.svg",
          "dark": "./icons/config.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "flame",
        "scopeName": "source.flame",
        "path": "./syntaxes/flame.tmLanguage.json"
      },
      {
        "language": "flame-wn",
        "scopeName": "source.flame",
        "path": "./syntaxes/flame.tmLanguage.json"
      },
      {
        "language": "flame-config",
        "scopeName": "source.flame",
        "path": "./syntaxes/flame.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "flame-icons",
        "label": "Flame Icons",
        "path": "./icons/fileicons.json"
      }
    ]
  }
}
import std.net.http
import std.json
import std.net.tcp
import std.net.udp
import std.thread



@Application(
features = ["http", "tcp", "udp", "net"]
)
async fn main() {
    // Server thread
    let listener = tcp.TcpListener.bind("127.0.0.1:8081")
    thread {
        for client in listener {
            let req = client.read()
            println($"Server received: {req}")
            client.write("Hello from TCP Server!")
            client.close()
            break // Close server after one client
        }
    }
    
    // Client connection
    thread.sleep(100)
    let socket = tcp.TcpSocket.connect("127.0.0.1:8081")
    socket.write("Hello TCP Server!")
    let response = socket.read()
    println($"Client received: {response}")
    socket.close()

    // 2. HTTP Test
    println("\n--- Testing HTTP ---")
    let get_res = await http.get("https://httpbin.org/get")
    let get_text = await get_res.text()
    println($"HTTP GET Response length: {get_text.len()}")

    let postData = formula { title: "foo", body: "bar", userId: 1 }
    let post_res = await http.post("https://httpbin.org/post", postData)
    let post_json = await post_res.text()
    println($"HTTP POST Response length: {post_json.len()}")
    
    // 3. UDP Test
    println("\n--- Testing UDP ---")
    let udp_server = udp.UdpSocket.bind("127.0.0.1:9090")
    thread {
        let (msg, addr) = udp_server.recv()
        println($"UDP Server received: {msg} from {addr}")
        udp_server.send("Hello from UDP Server!", addr)
    }

    thread.sleep(100)
    let udp_client = udp.UdpSocket.bind("127.0.0.1:0")
    udp_client.send("Hello UDP Server!", "127.0.0.1:9090")
    let (udp_res, s_addr) = udp_client.recv()
    println($"UDP Client received: {udp_res} from {s_addr}")
    println("\nAll network tests completed successfully!")
}

import native.server



fn home() -> String {
    "hello from flame"
}

fn about() -> String {
    "about page"
}

let app = await server.init()
app.get("/", home)
app.get("/about", about)
fn create_user(body: String) -> String {
    print($"Received POST data: {body}")

    $"Created user with data: {body}"
}

app.post("/users", create_user)
await app.listen(3000)

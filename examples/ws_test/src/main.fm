import std.net.ws
import std.thread



println("Starting Flame WebSocket Server...")

let s = ws.Socket.listen("127.0.0.1:8999")

println($"[Server] Listening on {s.address} (port: {s.port})")

s.onConnect(
    (client) {
        println($"[Server] Client connected: {client.id} ({client.address})")
        client.send("WELCOME")
    }
)

s.onMessage(
    (client, 
    msg: String) {
        println($"[Server] Text message: {msg}")
        if msg == "BROADCAST_TEST" {
            s.broadcast("BROADCAST_OK")
        } else {
            client.send($"ECHO: {msg}")
        }
    }
)

s.onBinary(
    (client, 
    bytes) {
        println($"[Server] Binary frame: {bytes.len()} bytes")
        client.sendBytes(bytes)
    }
)

s.onClose(
    (client, 
    code, 
    reason) {
        println($"[Server] Client disconnected: {code} ({reason})")
    }
)

println("[Server] Active and waiting for incoming connections...")

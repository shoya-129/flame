struct Student {
    name: String,
    age: Int,
    roll: Int,
    class: Int,
    parent: String
}

impl Student {
    fn edit(&mut self, field: String, value: String) -> Student {
        if field == "name" {
            self.name = value
        }

        if field == "parent" {
            self.parent = value
        }

        if field == "age" {
            self.age = value.tryInt()
        }

        if field == "roll" {
            self.roll = value.tryInt()
        }

        if field == "class" {
            self.class = value.tryInt()
        }

        return self
    }

}

let mut students: [Student] = []

while true {
    println("Options")
    println("Option 1 => Create new student")
    println("Option 2 => Edit student details")
    println("Option 3 => Delete student data")
    println("Option 4 => Exit")

    let optInput = input("Enter option: ").tryInt()

    match optInput {
        1 => {
            println("--- Student Creation ---")

            let name = input("Enter student name: ")
            let age = input("Enter student age: ").tryInt()
            let roll = input("Enter student roll: ").tryInt()
            let class = input("Enter student class: ").tryInt()
            let parent = input("Enter student parent: ")

            if class > 12 {
                println("Invalid class!")

                continue
            }

            let new_student = Student {
                name: name,
                age: age,
                roll: roll,
                class: class,
                parent: parent

            }

            students.push(new_student)
            println($"New student craeted {new_student.name}")

        }

        2 => {
            println("--- Student Edit ---")

            let roll = input("Enter student roll: ").tryInt()
            let class = input("Enter student class: ").tryInt()
            let mut found_index = - 1
            let mut i = 0

            while i < students.len() {
                if students[i].roll == roll and students[i].class == class {
                    found_index = i
                    break
                }

                i+=1
            }

            if found_index == - 1 {
                println("Student not found!")

                continue
            }

            let filed = input("Enter field name: ")
            let value = input("Enter field value: ")

            students[found_index] = students[found_index].edit(filed, value)
            println($"Student {students[found_index].name} updated!")

        }

        3 => {
        }

        4 => {
            break
        }

        _ => {
            println("Invalid Option!")

        }

    }

}

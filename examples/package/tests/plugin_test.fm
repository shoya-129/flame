import native.bridge



@Test
fn test_rust_add() {
    let result = bridge.rust_add(10, 20)

    assert_eq(result, 30, "10 + 20 should be 30")
}

@Test
fn test_rust_is_positive() {
    let is_pos = bridge.rust_is_positive(5)

    assert_eq(is_pos, true, "5 is positive")
    let is_neg = bridge.rust_is_positive( - 5)

    assert_eq(is_neg, false, "-5 is not positive")
}

@Test
fn test_rust_bool_to_string() {
    let t_str = bridge.rust_bool_to_string(true)

    assert_eq(t_str, "true", "true should become 'true'")
}

@Test
fn test_rust_string_length() {
    let len = bridge.rust_string_length("Hello Native")

    assert_eq(len, 12, "Length of 'Hello Native' should be 12")
}

@Test
fn test_rust_double() {
    let doubled = bridge.rust_double(2.5)

    assert_eq(doubled, 5.0, "2.5 doubled should be 5.0")
}

@Test
fn test_rust_bytes_sum() {
    let sum = bridge.rust_bytes_sum([10, 20, 30])

    assert_eq(sum, 60, "Sum of bytes should be 60")
}

@Test
fn test_rust_maybe_positive() {
    let opt_some = bridge.rust_maybe_positive(10)

    assert_eq(opt_some, Some(10), "Should return Some(10)")
    let opt_none = bridge.rust_maybe_positive( - 10)

    assert_eq(opt_none, None, "Should return None")
}

@Test
fn test_rust_checked_add() {
    let res_ok = bridge.rust_checked_add(100, 200)

    assert_eq(res_ok, Ok(300), "Should return Ok(300)")
    let res_err = bridge.rust_checked_add(9223372036854775807, 1)// MAX_INT + 1

    assert_eq(res_err, Err("integer overflow"), "Should return Err for overflow")
}

@Test
fn test_counter_struct() {
    let counter = bridge.Counter.new(5)

    assert_eq(counter.get(), 5, "Counter should start at 5")
    counter.increment()
    counter.increment()
    assert_eq(counter.get(), 7, "Counter should be 7 after two increments")
}

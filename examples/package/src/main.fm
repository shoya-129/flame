
import std.net.http
import flamer
import std.time
import std.json



let bot_token = "8975410427:AAHKXcYlPm9imIfTQmt6YkX9c3rRfv9fpcs"

async fn webhook(body: Formula) -> Formula {
    println($"WEBHOOK BODY: {body}")

    let data = json.parse(body)
    let chat_id = data.message.chat.id
    let text = data.message.text

    println($"CHAT ID: {chat_id}")
    println($"TEXT: {text}")

    let mut reply_text = ""

    if text == "/start" {
        reply_text = "Welcome to Flame Bot! Send me a message."
    } else {
        reply_text = $"You said: {text}"
    }

    let send_url = $"https://api.telegram.org/bot{bot_token}/sendMessage"
    let payload = {

        chat_id: chat_id,
        text: reply_text
    }

    let send_res = await http.post(send_url, payload)

    println($"Telegram response: {send_res.text()}")

    return {
        ok: true
    }

}

@Flamer(port: 3000)
async fn main() {
    println("--- Flame Telegram Bot Webhook Server ---")
    println("Server listening on port 3000.")
    println("Don't forget to set your Telegram webhook to point to this server: /webhook")

    flamer.get(
        "/", 
        () -> String {
            "hello"
        }
    )
    flamer.post("/webhook", webhook)
    await flamer.listen()
}

await main()

---
export interface Props {
  initialCode?: string;
  boardTitle?: string;
}

const { 
  initialCode = `import std.embedded\n\n// 1. Configure Hardware Capabilities\nlet led = embedded.pin(13)\nlet servo = embedded.servo(5)\nlet motor = embedded.motor(9, 7, 8)\nlet oled = embedded.display\n\n// 2. Execute Hardware Action Loop\noled.clear()\noled.text("Flame OS v0.1.6 Active")\n\nled.mode("Output")\nled.high()\n\nprint("Rotating Servo Horn to 120°...")\nservo.angle(120)\n\nprint("Energizing DC Motor...")\nmotor.forward()\nmotor.speed(85.0)\n\nprint("All actuators synchronized successfully!")`,
  boardTitle = "Flame Virtual ARM / ESP32 Hardware Lab"
} = Astro.props;
---

<div class="flame-sim-container">
  <div class="sim-header">
    <div class="header-title">
      <span class="pulse-indicator"></span>
      <span class="board-badge">LIVE LAB</span>
      <h3>{boardTitle}</h3>
    </div>
    <div class="sim-controls">
      <button id="run-btn" class="action-btn run-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
        Execute Hardware Script
      </button>
      <button id="reset-btn" class="action-btn reset-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        Reset Board
      </button>
    </div>
  </div>

  <div class="sim-main-grid">
    <!-- Left Column: Intelligent Code Editor -->
    <div class="editor-pane">
      <div class="pane-bar">
        <span class="pane-tab active">main.fm</span>
        <span class="completion-hint">✦ Flame Intellisense Active</span>
      </div>
      <div class="editor-wrapper">
        <div class="line-numbers" id="line-num-col"></div>
        <div class="code-area-container">
          <textarea id="flame-editor-input" spellcheck="false" autocomplete="off" autocapitalize="off">{initialCode}</textarea>
          <!-- Autocompletion Suggestions Box -->
          <div id="suggest-box" class="suggest-box hidden">
            <div class="suggest-header">Flame Suggestions</div>
            <ul id="suggest-list"></ul>
          </div>
        </div>
      </div>
      <div class="editor-footer">
        <span>Backend: embedded-hal 1.0 Native</span>
        <span>Target: ARM / ESP32 / AVR</span>
        <span class="status-badge ready" id="compiler-status">Ready to Compile</span>
      </div>
    </div>

    <!-- Right Column: Interactive Virtual Hardware Canvas -->
    <div class="hardware-pane">
      <div class="pane-bar">
        <span class="pane-title">Virtual Hardware Bench & Sensors</span>
        <span class="voltage-indicator">VCC: 3.3V REGULATED</span>
      </div>

      <div class="hardware-bench">
        <!-- Module 1: OLED Graphic Framebuffer -->
        <div class="hw-module oled-module">
          <div class="mod-label">SPI / I2C OLED Framebuffer [0x3C]</div>
          <div class="oled-screen">
            <div class="oled-glare"></div>
            <div class="oled-content" id="oled-text">FLAME OS READY</div>
            <div class="oled-status">FPS: 60 | BUS: I2C FAST</div>
          </div>
        </div>

        <div class="hw-split-grid">
          <!-- Module 2: Servo Motor Horn Actuator -->
          <div class="hw-module actuator-card">
            <div class="mod-label">Hobby Servo Actuator [Pin 5]</div>
            <div class="servo-container">
              <div class="servo-dial">
                <div class="servo-horn" id="servo-horn" style="transform: rotate(0deg);">
                  <div class="horn-blade"></div>
                  <div class="horn-hub"></div>
                </div>
                <div class="angle-labels">
                  <span class="deg-0">0°</span>
                  <span class="deg-90">90°</span>
                  <span class="deg-180">180°</span>
                </div>
              </div>
              <div class="readout">Angle: <strong id="servo-angle-display">0°</strong></div>
            </div>
          </div>

          <!-- Module 3: DC Motor Actuator & H-Bridge -->
          <div class="hw-module actuator-card">
            <div class="mod-label">DC Motor & H-Bridge [Pin 9]</div>
            <div class="motor-container">
              <div class="motor-rotor" id="motor-rotor">
                <div class="blade blade-1"></div>
                <div class="blade blade-2"></div>
                <div class="blade blade-3"></div>
                <div class="blade blade-4"></div>
                <div class="rotor-cap"></div>
              </div>
              <div class="motor-telemetry">
                <div class="state-pill" id="motor-state-pill">STOPPED</div>
                <div class="readout">Duty: <strong id="motor-duty-display">0.0%</strong></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Module 4: GPIO Digital & Analog Pin Matrix -->
        <div class="hw-module gpio-module">
          <div class="mod-label">GPIO Pin Bank & LED Indicators</div>
          <div class="pin-grid">
            <div class="pin-chip">
              <div class="led-bulb led-red" id="led-13"></div>
              <span class="pin-name">PIN 13 (LED)</span>
              <span class="pin-val" id="val-13">LOW</span>
            </div>
            <div class="pin-chip">
              <div class="led-bulb led-green" id="led-9"></div>
              <span class="pin-name">PIN 9 (PWM)</span>
              <span class="pin-val" id="val-9">0%</span>
            </div>
            <div class="pin-chip">
              <div class="led-bulb led-blue" id="led-2"></div>
              <span class="pin-name">PIN 2 (INT)</span>
              <span class="pin-val" id="val-2">LOW</span>
            </div>
            <div class="pin-chip">
              <div class="adc-meter">
                <div class="meter-bar" id="adc-bar" style="width: 50%;"></div>
              </div>
              <span class="pin-name">ADC 0 (POT)</span>
              <span class="pin-val" id="val-adc">1.65V</span>
            </div>
          </div>
        </div>

        <!-- Module 5: Logic Analyzer Oscilloscope Waveform -->
        <div class="hw-module scope-module">
          <div class="mod-label">Logic Analyzer / Oscilloscope Waveform Trace</div>
          <div class="scope-screen">
            <svg class="waveform-svg" viewBox="0 0 500 80">
              <defs>
                <linearGradient id="trace-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.3"/>
                  <stop offset="100%" stop-color="#00f2fe" stop-opacity="1"/>
                </linearGradient>
              </defs>
              <path id="waveform-path" d="M 0 60 L 50 60 L 50 20 L 120 20 L 120 60 L 180 60 L 180 20 L 250 20 L 250 60 L 320 60 L 320 20 L 400 20 L 400 60 L 500 60" stroke="url(#trace-grad)" stroke-width="2.5" fill="none" />
            </svg>
            <div class="scope-overlay-grid"></div>
          </div>
        </div>

        <!-- Module 6: Serial Terminal Console Output -->
        <div class="hw-module terminal-module">
          <div class="mod-label">Serial UART Monitor (115200 Baud)</div>
          <div class="terminal-box" id="serial-output">
            <span class="sys-msg">[SYSTEM] Ready. Flash runtime binary to begin execution...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  :root {
    --bg-dark: #090b10;
    --panel-bg: #10141d;
    --panel-border: #1e2536;
    --accent-primary: #ff5e36;
    --accent-secondary: #00f2fe;
    --text-main: #f0f4fd;
    --text-dim: #8896b5;
    --code-bg: #0c0f17;
    --led-off: #2a334a;
  }

  .flame-sim-container {
    background: var(--bg-dark);
    border: 1px solid var(--panel-border);
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--text-main);
    overflow: hidden;
    margin: 2rem 0;
  }

  .sim-header {
    background: linear-gradient(135deg, #131a29 0%, #0d121c 100%);
    padding: 0.9rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--panel-border);
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .header-title h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: linear-gradient(90deg, #fff, #a5b4fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .pulse-indicator {
    width: 10px;
    height: 10px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
    animation: pulse 2s infinite;
  }

  .board-badge {
    background: rgba(255, 94, 54, 0.15);
    color: var(--accent-primary);
    border: 1px solid rgba(255, 94, 54, 0.35);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    letter-spacing: 1px;
  }

  .sim-controls {
    display: flex;
    gap: 0.75rem;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .run-btn {
    background: linear-gradient(135deg, #ff5e36 0%, #e0380d 100%);
    border: none;
    color: white;
    box-shadow: 0 4px 15px rgba(255, 94, 54, 0.4);
  }

  .run-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 94, 54, 0.6);
  }

  .reset-btn {
    background: #192132;
    border: 1px solid var(--panel-border);
    color: var(--text-dim);
  }

  .reset-btn:hover {
    color: var(--text-main);
    background: #202b42;
  }

  .sim-main-grid {
    display: grid;
    grid-template-columns: 1.15fr 1.35fr;
    min-height: 560px;
  }

  @media (max-width: 1024px) {
    .sim-main-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Code Editor Pane */
  .editor-pane {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--panel-border);
    background: var(--code-bg);
  }

  .pane-bar {
    background: #111622;
    padding: 0.6rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--panel-border);
    font-size: 0.8rem;
  }

  .pane-tab {
    color: var(--text-main);
    font-weight: 600;
    background: #1c2436;
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    border: 1px solid #28344e;
  }

  .completion-hint {
    color: var(--accent-secondary);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .editor-wrapper {
    flex: 1;
    display: flex;
    position: relative;
  }

  .line-numbers {
    padding: 1rem 0.6rem;
    background: #0a0d14;
    color: #43516f;
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
    font-size: 0.88rem;
    line-height: 1.6;
    text-align: right;
    user-select: none;
    border-right: 1px solid #151b2a;
    min-width: 40px;
  }

  .code-area-container {
    flex: 1;
    position: relative;
  }

  #flame-editor-input {
    width: 100%;
    height: 100%;
    min-height: 440px;
    background: transparent;
    border: none;
    color: #a7f3d0;
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
    font-size: 0.88rem;
    line-height: 1.6;
    padding: 1rem;
    resize: none;
    outline: none;
    tab-size: 4;
  }

  /* Autocompletion Suggestions Box */
  .suggest-box {
    position: absolute;
    top: 50px;
    left: 80px;
    width: 280px;
    background: rgba(16, 20, 31, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid #00f2fe;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 242, 254, 0.2);
    z-index: 50;
    overflow: hidden;
  }

  .suggest-header {
    background: rgba(0, 242, 254, 0.15);
    color: #00f2fe;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.4rem 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(0, 242, 254, 0.3);
  }

  .suggest-box ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 220px;
    overflow-y: auto;
  }

  .suggest-box li {
    padding: 0.5rem 0.8rem;
    font-size: 0.82rem;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-main);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .suggest-box li:hover, .suggest-box li.selected {
    background: rgba(255, 94, 54, 0.2);
    color: #fff;
    border-left: 3px solid var(--accent-primary);
  }

  .suggest-meta {
    font-size: 0.7rem;
    color: #6366f1;
    background: rgba(99, 102, 241, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .hidden {
    display: none !important;
  }

  .editor-footer {
    background: #090c13;
    border-top: 1px solid var(--panel-border);
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status-badge {
    padding: 0.15rem 0.6rem;
    border-radius: 12px;
    font-weight: 700;
  }
  .status-badge.ready {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }
  .status-badge.running {
    background: rgba(255, 193, 7, 0.15);
    color: #ffc107;
    border: 1px solid rgba(255, 193, 7, 0.4);
  }

  /* Hardware Pane */
  .hardware-pane {
    background: var(--panel-bg);
    display: flex;
    flex-direction: column;
  }

  .voltage-indicator {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    color: #10b981;
  }

  .hardware-bench {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    max-height: 720px;
  }

  .hw-module {
    background: #141a27;
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    padding: 0.9rem;
    position: relative;
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.2);
  }

  .mod-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-dim);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .hw-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  /* OLED Screen */
  .oled-screen {
    background: #020712;
    border: 2px solid #23314d;
    border-radius: 6px;
    height: 75px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.15);
    overflow: hidden;
  }

  .oled-glare {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0) 50%);
    pointer-events: none;
  }

  .oled-content {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 800;
    color: #00f2fe;
    text-shadow: 0 0 10px #00f2fe;
    letter-spacing: 2px;
  }

  .oled-status {
    position: absolute;
    bottom: 4px;
    right: 8px;
    font-size: 0.6rem;
    color: #384b70;
    font-family: 'JetBrains Mono', monospace;
  }

  /* Servo Actuator */
  .servo-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem;
  }

  .servo-dial {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #1c2436;
    border: 2px dashed #3a4b6e;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .servo-horn {
    width: 100%;
    height: 100%;
    position: absolute;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .horn-blade {
    width: 32px;
    height: 8px;
    background: #ff5e36;
    border-radius: 4px;
    position: absolute;
    top: 34px;
    left: 38px;
    box-shadow: 0 0 8px rgba(255, 94, 54, 0.6);
  }

  .horn-hub {
    width: 14px;
    height: 14px;
    background: #fff;
    border-radius: 50%;
    position: absolute;
    top: 31px;
    left: 31px;
    border: 2px solid #333;
  }

  .angle-labels span {
    position: absolute;
    font-size: 0.6rem;
    color: var(--text-dim);
    font-weight: 700;
  }
  .deg-0 { right: -15px; top: 32px; }
  .deg-90 { top: -16px; left: 30px; }
  .deg-180 { left: -22px; top: 32px; }

  /* DC Motor Rotor */
  .motor-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem;
  }

  .motor-rotor {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #1d2538;
    border: 3px solid #3b4c73;
    position: relative;
  }

  .motor-rotor.spinning {
    animation: spin 0.4s linear infinite;
  }

  .blade {
    position: absolute;
    width: 24px;
    height: 8px;
    background: #a855f7;
    border-radius: 4px;
    top: 25px;
    left: 32px;
    transform-origin: 0% 50%;
  }
  .blade-1 { transform: rotate(0deg); }
  .blade-2 { transform: rotate(90deg); }
  .blade-3 { transform: rotate(180deg); }
  .blade-4 { transform: rotate(270deg); }

  .rotor-cap {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #cbd5e1;
    position: absolute;
    top: 21px;
    left: 21px;
    border: 2px solid #475569;
  }

  .motor-telemetry {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .state-pill {
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 800;
    background: #334155;
    color: #f8fafc;
  }
  .state-pill.active {
    background: #10b981;
    color: #fff;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
  }

  /* GPIO Bank & LEDs */
  .pin-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .pin-chip {
    background: #1a2233;
    border: 1px solid #283550;
    border-radius: 6px;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .led-bulb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--led-off);
    border: 2px solid #3c4c70;
    transition: all 0.3s ease;
  }

  .led-bulb.active.led-red {
    background: #ff3838;
    box-shadow: 0 0 16px #ff3838, inset 0 0 6px #fff;
    border-color: #ff8e8e;
  }
  .led-bulb.active.led-green {
    background: #10b981;
    box-shadow: 0 0 16px #10b981, inset 0 0 6px #fff;
    border-color: #6ee7b7;
  }
  .led-bulb.active.led-blue {
    background: #3b82f6;
    box-shadow: 0 0 16px #3b82f6, inset 0 0 6px #fff;
    border-color: #93c5fd;
  }

  .adc-meter {
    width: 35px;
    height: 20px;
    background: #0f172a;
    border-radius: 3px;
    border: 1px solid #334155;
    overflow: hidden;
  }
  .meter-bar {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #00f2fe);
    transition: width 0.3s ease;
  }

  .pin-name {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-dim);
  }
  .pin-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 800;
    color: #e2e8f0;
  }

  /* Scope Module */
  .scope-screen {
    background: #080c14;
    border: 1px solid #1e293b;
    border-radius: 4px;
    height: 60px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .waveform-svg {
    width: 100%;
    height: 100%;
  }

  .scope-overlay-grid {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }

  /* Terminal Module */
  .terminal-box {
    background: #0a0e17;
    border: 1px solid #1d283c;
    border-radius: 6px;
    padding: 0.7rem 0.9rem;
    height: 110px;
    overflow-y: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sys-msg { color: #64748b; }
  .tx-msg { color: #38bdf8; font-weight: 700; }
  .rx-msg { color: #4ade80; }

  @keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.92); }
    100% { opacity: 1; transform: scale(1); }
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  // Complete Interactive Simulation & Autocompletion Engine
  document.addEventListener('DOMContentLoaded', () => {
    const editor = document.getElementById('flame-editor-input') as HTMLTextAreaElement;
    const lineCol = document.getElementById('line-num-col');
    const suggestBox = document.getElementById('suggest-box');
    const suggestList = document.getElementById('suggest-list');
    const runBtn = document.getElementById('run-btn');
    const resetBtn = document.getElementById('reset-btn');
    const compilerStatus = document.getElementById('compiler-status');
    const serialOutput = document.getElementById('serial-output');

    // Actuators & DOM elements
    const oledText = document.getElementById('oled-text');
    const servoHorn = document.getElementById('servo-horn');
    const servoDisplay = document.getElementById('servo-angle-display');
    const motorRotor = document.getElementById('motor-rotor');
    const motorState = document.getElementById('motor-state-pill');
    const motorDuty = document.getElementById('motor-duty-display');
    const led13 = document.getElementById('led-13');
    const val13 = document.getElementById('val-13');
    const led9 = document.getElementById('led-9');
    const val9 = document.getElementById('val-9');
    const led2 = document.getElementById('led-2');
    const val2 = document.getElementById('val-2');

    // Exhaustive Flame Keyword & std.embedded Suggestions Matrix
    const suggestions = [
      { text: "embedded.pin(13)", meta: "GPIO Pin Driver", desc: "Create exclusive output pin capability" },
      { text: "embedded.analog(0)", meta: "ADC Driver", desc: "12-bit Analog-to-Digital reading" },
      { text: "embedded.pwm(9)", meta: "PWM Actuator", desc: "Pulse-width hardware signal" },
      { text: "embedded.servo(5)", meta: "Actuator", desc: "Hobby servo angle control" },
      { text: "embedded.motor(9, 7, 8)", meta: "Robotics", desc: "DC motor H-Bridge controller" },
      { text: "embedded.display", meta: "Display Driver", desc: "I2C/SPI OLED screen framebuffer" },
      { text: "embedded.i2c(0x3C)", meta: "I2C Bus", desc: "Two-wire synchronized bus communications" },
      { text: "embedded.spi()", meta: "SPI Bus", desc: "High-speed synchronous SPI driver" },
      { text: "embedded.can(500000)", meta: "CAN Bus", desc: "Automotive/Robotics differential network" },
      { text: "embedded.diffDrive()", meta: "Kinematics", desc: "Two-wheel differential chassis driver" },
      { text: "embedded.board", meta: "System Specs", desc: "Inspect real CPU and RAM capabilities" },
      { text: ".high()", meta: "Output Pin", desc: "Set logic HIGH (3.3V)" },
      { text: ".low()", meta: "Output Pin", desc: "Set logic LOW (0.0V)" },
      { text: ".toggle()", meta: "Output Pin", desc: "Invert current state" },
      { text: ".angle(120)", meta: "Servo Motor", desc: "Rotate horn to desired degrees" },
      { text: ".forward()", meta: "DC Motor", desc: "Energize motor forward rotation" },
      { text: ".speed(80.0)", meta: "DC Motor", desc: "Throttle motor PWM percent" },
      { text: ".text(\"Flame Ready\")", meta: "OLED Screen", desc: "Render string to display buffer" },
      { text: "import std.embedded", meta: "Module", desc: "Import hardware runtime ecosystem" }
    ];

    function updateLineNumbers() {
      if (!editor || !lineCol) return;
      const lines = editor.value.split('\n').length;
      lineCol.innerHTML = Array.from({ length: lines }, (_, i) => i + 1).join('<br/>');
    }

    if (editor) {
      editor.addEventListener('input', (e) => {
        updateLineNumbers();
        const cursor = editor.selectionStart;
        const val = editor.value.slice(0, cursor);
        const match = val.match(/([a-zA-Z0-9_\.]+)$/);

        if (match && match[1].length >= 2 && suggestBox && suggestList) {
          const query = match[1].toLowerCase();
          const filtered = suggestions.filter(s => s.text.toLowerCase().includes(query));
          
          if (filtered.length > 0) {
            suggestList.innerHTML = filtered.map(s => 
              `<li data-val="${s.text}">
                <span>${s.text} <small style="color:#64748b; font-size:0.75rem;">— ${s.desc}</small></span>
                <span class="suggest-meta">${s.meta}</span>
              </li>`
            ).join('');
            suggestBox.classList.remove('hidden');

            suggestList.querySelectorAll('li').forEach(li => {
              li.addEventListener('click', () => {
                const replaceText = li.getAttribute('data-val') || '';
                const start = cursor - match[1].length;
                editor.value = editor.value.slice(0, start) + replaceText + editor.value.slice(cursor);
                suggestBox.classList.add('hidden');
                editor.focus();
              });
            });
          } else {
            suggestBox.classList.add('hidden');
          }
        } else if (suggestBox) {
          suggestBox.classList.add('hidden');
        }
      });

      editor.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && suggestBox) {
          suggestBox.classList.add('hidden');
        }
      });

      updateLineNumbers();
    }

    function addLog(msg: string, type = "rx") {
      if (!serialOutput) return;
      const span = document.createElement('span');
      span.className = type === "tx" ? "tx-msg" : (type === "sys" ? "sys-msg" : "rx-msg");
      span.textContent = msg;
      serialOutput.appendChild(span);
      serialOutput.scrollTop = serialOutput.scrollHeight;
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (oledText) oledText.textContent = "STANDBY";
        if (servoHorn) servoHorn.style.transform = "rotate(0deg)";
        if (servoDisplay) servoDisplay.textContent = "0°";
        if (motorRotor) motorRotor.classList.remove('spinning');
        if (motorState) { motorState.textContent = "STOPPED"; motorState.classList.remove('active'); }
        if (motorDuty) motorDuty.textContent = "0.0%";
        if (led13) led13.classList.remove('active');
        if (val13) val13.textContent = "LOW";
        if (led9) led9.classList.remove('active');
        if (val9) val9.textContent = "0%";
        addLog("[SYSTEM] Hardware register state reset to defaults.", "sys");
      });
    }

    if (runBtn) {
      runBtn.addEventListener('click', () => {
        const code = editor ? editor.value : "";
        if (compilerStatus) {
          compilerStatus.textContent = "Compiling to Native HAL...";
          compilerStatus.className = "status-badge running";
        }
        addLog("[BUILD] Invoking avr-gcc & embedded-hal compiler toolchain...", "tx");

        setTimeout(() => {
          if (compilerStatus) {
            compilerStatus.textContent = "Executing Target";
            compilerStatus.className = "status-badge ready";
          }
          addLog("[FLAME HAL] Upload complete. Executing firmware on virtual target...", "rx");

          // Parse and emulate visual feedback from Flame code
          if (code.includes("oled.text(") && oledText) {
            const match = code.match(/oled\.text\((["'][^"']+["'])/);
            if (match) {
              const text = match[1].replace(/["']/g, "");
              oledText.textContent = text;
              addLog(`[I2C BUS] Framebuffer updated -> "${text}" @ 0x3C`, "rx");
            }
          }

          if (code.includes("led.high()") || code.includes("pin(13).high()")) {
            if (led13 && val13) {
              led13.classList.add('active');
              val13.textContent = "HIGH (3.3V)";
              addLog("[GPIO REGISTER] PORTB bit asserted HIGH on Pin 13", "rx");
            }
          }

          if (code.includes("servo.angle(")) {
            const match = code.match(/servo\.angle\(([0-9]+)\)/);
            const ang = match ? parseInt(match[1]) : 90;
            if (servoHorn && servoDisplay) {
              servoHorn.style.transform = `rotate(${ang}deg)`;
              servoDisplay.textContent = `${ang}°`;
              addLog(`[TIMER PWM] Servo horn actuated to calibrated ${ang}°`, "rx");
            }
          }

          if (code.includes("motor.forward()") || code.includes("motor.speed(")) {
            if (motorRotor && motorState && motorDuty) {
              motorRotor.classList.add('spinning');
              motorState.textContent = "RUNNING FWD";
              motorState.classList.add('active');
              const match = code.match(/motor\.speed\(([0-9\.]+)\)/);
              const sp = match ? parseFloat(match[1]) : 100;
              motorDuty.textContent = `${sp}%`;
              if (led9 && val9) {
                led9.classList.add('active');
                val9.textContent = `${sp}%`;
              }
              addLog(`[H-BRIDGE MOTOR] Duty cycle set to ${sp}%, spinning forward.`, "rx");
            }
          }
        }, 600);
      });
    }
  });
</script>

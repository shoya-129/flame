---
interface Props {
	title: string;
	class?: string;
}

const { title, class: className } = Astro.props;
---

<article class:list={['card', 'sl-flex', className]}>
	<p class="title sl-flex">
		<span class="icon-wrapper">
			<slot name="icon" />
		</span>
		<span>{title}</span>
	</p>
	<div class="body">
		<slot />
	</div>
</article>

<style>
	.title {
		gap: 0.5rem;
	}
	.icon-wrapper {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--sl-color-accent);
		background-color: var(--sl-color-accent-low);
		color: var(--sl-color-accent);
		padding: 0.35rem;
		border-radius: 0.4rem;
		flex-shrink: 0;
	}
	.icon-wrapper :global(svg) {
		width: 1.35rem;
		height: 1.35rem;
		stroke-width: 2.2px;
	}
</style>
